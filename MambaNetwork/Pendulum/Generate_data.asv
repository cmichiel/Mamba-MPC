close all; clear all; clc;

%% N-step ahead predictor
clc; close all; clear all;

% load NMPC.mat

M = 1.   ;       % mass of the pendulum
L = 1.   ;       % lenght of the pendulum
b = 0.1  ;       % friction coefficient
g = 9.81  ;      % acceleration of gravity
J = 1/3*M*L^2 ;  % moment of inertia
Ts = 1/30;

fs = 1/Ts;                    % Sampling frequency (samples per second)
dt = 1/fs;                   % seconds per sample
StopTime = 34;                % seconds


Range = [-3.5, 3.5]
SineData = [25, 10, 1]
Band = [0,2]
NumPeriod = 1
Period = 10000
Nu = 1
%%

u_data1 = idinput([Period 1 NumPeriod],'sine',Band,Range,SineData)';
u_data2 = idinput([Period 1 NumPeriod],'sine',[0,100],Range,[100,100,1])';
u_data = [u_data1(1:Period/2), u_data2(1:Period/2),u_data1(Period/2+1:end), u_data2(Period/2+1:end)];

% u_data = zeros(1,length(u_data))
% SNR = 10;
% noise_u = randn(size(u_data))*std(u_data)/db2mag(SNR);
% u_data = u_data+noise_u ;

u_data = [u_data, 1*randn(1,Period)];
% u_data = [u_data, 2*randn(1,Period)];

%u_data = [u_data, 3*chirp(Period,0,2e1,20)];
%u_data = [u_data, idinput([Period 1 NumPeriod],'prbs',Band,[-4,4],[5,40,1])'];


t = 0:Ts:(length(u_data)-1)*Ts;
x1 = 0;
x2 = 0;
x = [x1;x2];

for i = 1:length(u_data)
    x1(i+1) = (1-b*Ts/J)*x1(i) + (Ts)/J*u_data(i) - (M*L*g*Ts)/(2*J)*sin(x2(i));
    x2(i+1) = Ts*x1(i) + x2(i);
    xk_step = [x1(i+1); x2(i+1)];
    x = [x,xk_step];
    y_data(i) = x2(i);
end 
% u_data = [u_data, uvec];
% y_data = [y_data, yvec];
%%
figure()
subplot(2,1,1)
plot(u_data)
title("Input data")
subplot(2,1,2)
plot(y_data)
title("Output data")


figure()
subplot(3,1,1)
hold on
plot( x1(1:end-1))
legend('x_1')
subplot(3,1,2)
hold on
plot( x2(1:end-1))
ylabel('x_2')
subplot(3,1,3)
plot( u_data)
ylabel('u')
xlabel('Time (s)')


figure()
plot(x1(:), x2(:))
%%
u_data = u_data.'
y_data = y_data.'
save('Datasets/u_dataLarge',"u_data")
save('Datasets/y_dataLarge',"y_data")
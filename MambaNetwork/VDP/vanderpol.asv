--------------------------close all; clear all; clc;  

fs = 10;                    % Sampling frequency (samples per second)
Ts = 1/fs;                  % seconds per sample
mu = 1;                     % Nonlinearity parameter (control input)
N = 10;

tspan = [0 Ts];
y0 = [0;1];                 % Initial conditions for y(1) and y(2)

u = 1;                      % Control input


Range = [-15,15];
SineData = [300, 10, 1];
Band = [0, 1000];
NumPeriod = 1;
period = 5000;

u_data1 = idinput([period 1 NumPeriod],'sine',Band,Range,SineData)';

u_data2 = idinput([period 1 NumPeriod],'sine',[0, 1],Range,[30, 10, 1])';
u_data = [u_data1(1:period/2), u_data2(1:period/2),u_data1(period/2+1:end), u_data2(period/2+1:end)];
t = 0:Ts:(length(u_data)-1)*Ts;
%% filter the signal 
period_vdp = 6.7000; % period limit cycle van der pol
f_vdp = 1/period_vdp; % eigenfrequency van der pol
w_vdp = f_vdp*2*pi; % frequency van der pol

s = tf('s')
alpha = w_vdp;

H = 1/(1+alpha*s);

f_vdp = 1; % Hz

figure()
hold on
bode(H)
xline(1/alpha)


u_data_filtered  = lsim(H,u_data,t)';

figure()
subplot(2,1,1)
plot(u_data)
subplot(2,1,2)
plot(u_data_filtered)
SNR = 1;
noise_u = randn(size(u_data_filtered))*std(u_data_filtered)/db2mag(SNR);
u_data = u_data_filtered;

%%
x_initial = [1,1];

x = y0
xk = y0;
y0 = []
t_vec = []
for i = 1:length(u_data)
    disp(string(i) + '/' + string(length(u_data)));
    u = u_data(i);
% Solve ODE using ode45
xk = [xk(1) + Ts*xk(2);  xk(2)+Ts*(mu*(1-xk(1)^2)*xk(2)-xk(1)+u)];
% [t,y] = ode45(@(t,y) vdp1(t,y,mu,u), tspan, y0);
y0 = [y0; xk(1)]; 
x = [x,[xk(1); xk(2)]];
t_vec = [t_vec,(i-1)*Ts];
end 


%% convert data to Hankel matrices
U = []
X0 = []
Y = []
for i = 1:length(u_data)-N
U = [U,u_data(i:i+N-1)'];
Y_i = [];
for j = 0:N
Y_i = [Y_i; x(:,i+j)];
end 
X0 = [X0,Y_i(1:2)];
Y = [Y,Y_i(3:end)];
end 
%% make plots
% Plot the results
figure()
subplot(3,1,1)
hold on
plot(t_vec, x(1,1:end-1))
legend('x_1')
subplot(3,1,2)
hold on
plot(t_vec, x(2,1:end-1))
ylabel('x_2')
subplot(3,1,3)
plot(t_vec, u_data)
ylabel('u')
xlabel('Time (s)')


figure()
plot(x(1,:), x(2,:))
y_data = y0';
save('Datasets/u_dataThomasNoise_SNR'+string(SNR)+'.mat',"u_data")
save('Datasets/y_dataThomasNoise_SNR'+string(SNR)+'.mat',"y_data")


%% train test data
D_all = [X0;U;Y];


% Shuffle the rows randomly
rng('shuffle');  % Ensure randomness (optional, use 'shuffle' for different random seeds each time)
shuffled_indices = randperm(size(D_all, 2));

% Split into training and testing data
train_indices = shuffled_indices(1:period*0.8);  % First 800 indices for training
val_indices = shuffled_indices(period*0.8+1:period*0.9);  % Remaining 190 indices for testing
test_indices = shuffled_indices(period*0.9+1:end);  % Remaining 190 indices for testing

train_data = D_all(:,train_indices);  % 800 x 20 matrix for training
val_data = D_all(:, val_indices);    % 190 x 20 matrix for testing
test_data = D_all(:, test_indices);    % 190 x 20 matrix for testing

X0_train = train_data(1:2,:)';
U_train = train_data(3:12,:)';
Y_train = train_data(13:end,:)';

X0_val = val_data(1:2,:)';
U_val = val_data(3:12,:)';
Y_val = val_data(13:end,:)';

X0_test = test_data(1:2,:)';
U_test = test_data(3:12,:)';
Y_test = test_data(13:end,:)';

%% save data
% 
% save('DataSets/U_train','U_train')
% save('DataSets/X0_train','X0_train')
% save('DataSets/Y_train','Y_train')
% 
% 
% save('DataSets/U_val','U_val')
% save('DataSets/X0_val','X0_val')
% save('DataSets/Y_val','Y_val')
% 
% 
% save('DataSets/U_test','U_test')
% save('DataSets/X0_test','X0_test')
% save('DataSets/Y_test','Y_test')
